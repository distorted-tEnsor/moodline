# Copy to .env and edit. Every setting in app/config.py can be overridden here.

# --- artifacts ---------------------------------------------------------
# MOODLINE_ARTIFACT_PATH=artifacts/emotion_bigru.pt

# --- runtime -----------------------------------------------------------
# MOODLINE_DEVICE=auto              # auto | cpu | cuda | mps
# MOODLINE_TORCH_THREADS=2          # 0 = pick automatically (min(4, cores))
# MOODLINE_QUANTIZE=false           # int8: ~18% faster on CPU, |Δp| < 0.01

# --- request handling --------------------------------------------------
# MOODLINE_MAX_TEXT_LENGTH=2000
# MOODLINE_MAX_BATCH_ITEMS=64
# MOODLINE_CACHE_SIZE=2048          # 0 disables the LRU result cache

# --- micro-batching ----------------------------------------------------
# MOODLINE_BATCHING_ENABLED=true
# MOODLINE_BATCH_MAX_SIZE=32
# MOODLINE_BATCH_MAX_WAIT_MS=6

# --- service -----------------------------------------------------------
# MOODLINE_CORS_ORIGINS=https://example.com,https://www.example.com
# MOODLINE_API_KEY=                 # when set, /predict* require X-API-Key
# MOODLINE_RATE_LIMIT_PER_MINUTE=240
# MOODLINE_LOG_LEVEL=INFO
# MOODLINE_LOG_JSON=false
# MOODLINE_DOCS_ENABLED=true
